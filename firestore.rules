rules_version = '2';

// ============================================================
// StudyCzechBridge — Firestore security rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- user profiles ----------
    match /users/{uid} {
      allow read, write, create, update, delete: if signedIn();
    }

    // ---------- applications ----------
    match /applications/{appId} {
      allow read, write, create, update, delete: if signedIn();
    }

    // ---------- uploaded documents ----------
    match /documents/{docId} {
      allow read, write, create, update, delete: if signedIn();

      match /chunks/{chunkId} {
        allow read, write, create, update, delete: if signedIn();
      }
    }

    // ---------- contact messages ----------
    match /messages/{id} {
      allow create: if true;            // public contact form
      allow read, write, update, delete: if signedIn();
    }

    // ---------- tasks ----------
    match /tasks/{taskId} {
      allow read, write, create, update, delete: if signedIn();
    }

    // ---------- alerts ----------
    match /alerts/{alertId} {
      allow read, write, create, update, delete: if signedIn();
    }

    // ---------- milestones / journey ----------
    match /milestones/{mId} {
      allow read, write, create, update, delete: if signedIn();
    }
  }
}

