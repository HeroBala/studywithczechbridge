rules_version = '2';

// ============================================================
// StudyCzechBridge — Firestore security rules with Super Admin & Staff Permissions
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    // Allow full read and write access for all authenticated users (Super Admins, Admins, Agents, Students)
    match /{document=**} {
      allow read, write: if signedIn();
    }

    // Public contact form message submission
    match /messages/{id} {
      allow create: if true;
      allow read, write: if signedIn();
    }
  }
}
