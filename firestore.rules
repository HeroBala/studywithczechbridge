rules_version = '2';

// ============================================================
// StudyWithCzechBridge — Role-Based Firestore Security Rules
// Full support for Super Admin, Admin, Counselor, Admission Officer, Finance Manager,
// assignedAgentId, assignedAgentName, automatic known admin email authorization,
// and safe document property getters.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isKnownAdminEmail() {
      return signedIn() && request.auth.token.email != null && (
        request.auth.token.email.lower() == "admin@studywithczechbridge.com" ||
        request.auth.token.email.lower() == "superadmin@studywithczechbridge.com" ||
        request.auth.token.email.lower() == "info@studywithczechbridge.com" ||
        request.auth.token.email.lower() == "counselor@studywithczechbridge.com" ||
        request.auth.token.email.lower() == "admissions@studywithczechbridge.com" ||
        request.auth.token.email.lower() == "finance@studywithczechbridge.com" ||
        request.auth.token.email.lower() == "joya99sarkar66@gmail.com" ||
        request.auth.token.email.lower() == "herobala1997@gmail.com" ||
        request.auth.token.email.lower() == "1997herobala@gmail.com" ||
        request.auth.token.email.lower() == "admin@czechbridge.cz" ||
        request.auth.token.email.lower().matches('.*@(studywithczechbridge\\.com|czechbridge\\.cz)$') ||
        request.auth.token.email.lower().matches('.*superadmin.*') ||
        request.auth.token.email.lower().matches('^admin.*') ||
        request.auth.token.email.lower().matches('.*herobala.*')
      );
    }

    function userDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() 
        ? getUserData().get('role', isKnownAdminEmail() ? 'super_admin' : 'student')
        : (isKnownAdminEmail() ? 'super_admin' : 'student');
    }

    function isSuperAdmin() {
      return isKnownAdminEmail() || (signedIn() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'superadmin' ||
        (request.auth.token.keys().hasAny(['role']) && (
          request.auth.token.role == 'super_admin' || 
          request.auth.token.role == 'superadmin'
        ))
      ));
    }

    function isAdmin() {
      return isKnownAdminEmail() || (signedIn() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'superadmin' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'administrator' ||
        (request.auth.token.keys().hasAny(['role']) && (
          request.auth.token.role == 'super_admin' || 
          request.auth.token.role == 'superadmin' || 
          request.auth.token.role == 'admin' ||
          request.auth.token.role == 'administrator'
        ))
      ));
    }

    function isStaff() {
      return isKnownAdminEmail() || (signedIn() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'superadmin' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'administrator' ||
        getUserRole() == 'agent' ||
        getUserRole() == 'counselor' ||
        getUserRole() == 'councilor' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'advisor' ||
        getUserRole() == 'admission_officer' ||
        getUserRole() == 'officer' ||
        getUserRole() == 'finance_manager' ||
        getUserRole() == 'finance' ||
        (request.auth.token.keys().hasAny(['role']) && (
          request.auth.token.role in ['super_admin', 'superadmin', 'admin', 'administrator', 'agent', 'counselor', 'councilor', 'staff', 'advisor', 'admission_officer', 'officer', 'finance_manager', 'finance']
        ))
      ));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------
    // Public directories & University Catalogs (MENDELU, etc.)
    // ------------------------------------------------------------
    match /MENDELU/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /universities/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /programs/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ------------------------------------------------------------
    // Contact & Message Inquiries
    // ------------------------------------------------------------
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // ------------------------------------------------------------
    // Users profile collection (Includes assignedAgentId & role)
    // ------------------------------------------------------------
    match /users/{userId} {
      // Students can read their own profile; staff can read all student profiles
      allow read: if isOwner(userId) || isStaff();
      
      // Any authenticated user or staff can create a user doc
      allow create: if signedIn();
      
      // Users can update their profile; staff/admins can update any user profile
      allow update: if isOwner(userId) || isStaff() || isAdmin();
      
      // Admins and Super Admins can delete user profiles
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ------------------------------------------------------------
    // Applications collection
    // ------------------------------------------------------------
    match /applications/{appId} {
      allow read: if (
        isOwner(appId) ||
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow create: if signedIn();
      
      allow update: if (
        isOwner(appId) ||
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ------------------------------------------------------------
    // Documents collection and chunk subcollections
    // ------------------------------------------------------------
    match /documents/{docId} {
      allow read: if (
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow create: if signedIn();
      
      allow update: if (
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow delete: if (
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );

      match /chunks/{chunkId} {
        allow read, write: if signedIn();
      }
    }

    // ------------------------------------------------------------
    // Seminar registrations (Open for GSTU Seminar registration + Free Drink Pass)
    // ------------------------------------------------------------
    match /seminar_registrations/{regId} {
      allow read, create: if true;
      allow update, delete: if isStaff() || isAdmin() || isSuperAdmin();
    }

    // ------------------------------------------------------------
    // Tasks, Alerts, & Operations
    // ------------------------------------------------------------
    match /tasks/{taskId} {
      allow read, write: if signedIn();
    }

    match /alerts/{alertId} {
      allow read, write: if isStaff();
    }

    // ------------------------------------------------------------
    // Fallback rule for any other collection
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
