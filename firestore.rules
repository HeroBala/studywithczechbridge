rules_version = '2';

// ============================================================
// StudyWithCzechBridge — Role-Based Firestore Security Rules
// Supports assignedAgentId, assignedAgentName, super_admin hierarchy,
// automatic known admin email authorization, and safe document property getters.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isKnownAdminEmail() {
      return signedIn() && (
        request.auth.token.email == "admin@studywithczechbridge.com" ||
        request.auth.token.email == "superadmin@studywithczechbridge.com" ||
        request.auth.token.email == "joya99sarkar66@gmail.com" ||
        request.auth.token.email == "admin@czechbridge.cz"
      );
    }

    function userDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return userDocExists() ? getUserData().get('role', 'student') : 'student';
    }

    function isSuperAdmin() {
      return isKnownAdminEmail() || (signedIn() && getUserRole() == 'super_admin');
    }

    function isAdmin() {
      return isKnownAdminEmail() || (signedIn() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'administrator'
      ));
    }

    function isStaff() {
      return isKnownAdminEmail() || (signedIn() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'administrator' ||
        getUserRole() == 'agent' ||
        getUserRole() == 'counselor' ||
        getUserRole() == 'councilor' ||
        getUserRole() == 'staff' ||
        getUserRole() == 'advisor' ||
        getUserRole() == 'admission_officer' ||
        getUserRole() == 'finance_manager'
      ));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------
    // Public directories & University Catalogs (MENDELU, etc.)
    // ------------------------------------------------------------
    match /MENDELU/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /universities/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /programs/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------
    // Contact & Message Inquiries
    // ------------------------------------------------------------
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // ------------------------------------------------------------
    // Users profile collection (Includes assignedAgentId & role)
    // ------------------------------------------------------------
    match /users/{userId} {
      // Students can read their own profile; staff can read all student profiles
      allow read: if isOwner(userId) || isStaff();
      
      // New user registration creates their own document
      allow create: if signedIn() && (
        request.auth.uid == userId ||
        isStaff()
      );
      
      // Users can update their own details, but non-admins cannot elevate their own role
      allow update: if (
        isOwner(userId) && (
          !('role' in request.resource.data) ||
          request.resource.data.role == resource.data.get('role', 'student')
        )
      ) || isAdmin();
      
      // Only super_admin or admin can delete user profiles
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Applications collection
    // ------------------------------------------------------------
    match /applications/{appId} {
      allow read: if (
        isOwner(appId) ||
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow create: if signedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.auth.uid == appId ||
        isStaff()
      );
      
      allow update: if (
        isOwner(appId) ||
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // Documents collection and chunk subcollections
    // ------------------------------------------------------------
    match /documents/{docId} {
      allow read: if (
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow create: if signedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        isStaff()
      );
      
      allow update: if (
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );
      
      allow delete: if (
        (signedIn() && resource.data.get('userId', '') == request.auth.uid) ||
        isStaff()
      );

      match /chunks/{chunkId} {
        allow read, write: if signedIn();
      }
    }

    // ------------------------------------------------------------
    // Tasks, Alerts, & Operations
    // ------------------------------------------------------------
    match /tasks/{taskId} {
      allow read, write: if signedIn();
    }

    match /alerts/{alertId} {
      allow read, write: if isStaff();
    }

    // ------------------------------------------------------------
    // Fallback rule for any other collection
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
